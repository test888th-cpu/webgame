# Copy to .env for local development. Never commit .env.
# Values in <angle brackets> are placeholders: generate your own.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=ironbound
POSTGRES_DB=ironbound
POSTGRES_PASSWORD=<generate-a-local-password>

# --- API service ---
# Use the same password as above; compose builds this from the parts.
DATABASE_URL=postgres://ironbound:<generate-a-local-password>@localhost:5432/ironbound
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
SHUTDOWN_GRACE_MS=10000

# --- Backend tests ---
# A server where the user may CREATE DATABASE; each test file creates its own.
TEST_DATABASE_URL=postgres://ironbound:<generate-a-local-password>@localhost:5432/postgres
