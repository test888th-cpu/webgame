class_name RpgClassRegistry
extends RefCounted
## The nine reference classes, their specialisations and their equipment
## identity (Phase B2.1, docs/PHASE_B2_PLAN.md). Data from
## client/data/rpg_reference.json and rpg/talent_structure.json, generated by
## tools/content/build_reference_registries.py from World of ClaudeCraft at the
## commit each file records. Read through ContentDB; not used by gameplay yet.

## The approved roster, in the owner's order.
const ROSTER: Array[String] = [
	"warrior", "paladin", "hunter", "rogue", "priest", "shaman", "mage", "warlock", "druid"
]
const ROLES: Array[String] = ["dps", "tank", "healer"]
const RESOURCES: Array[String] = ["rage", "mana", "energy", "focus"]
const PRIMARY_STATS: Array[String] = ["str", "agi", "int"]
const ARMOR: Array[String] = ["cloth", "leather", "mail"]


static func classes(content: ContentDB) -> Dictionary:
	return content.rpg.get("classes", {})


static func class_def(content: ContentDB, class_id: String) -> Dictionary:
	return classes(content).get(class_id, {})


## The class's specialisations: [{id, display_name, role, primary_stat,
## signature, ref}].
static func specs(content: ContentDB, class_id: String) -> Array:
	return class_def(content, class_id).get("specs", [])


static func spec(content: ContentDB, class_id: String, spec_id: String) -> Dictionary:
	for entry: Dictionary in specs(content, class_id):
		if entry["id"] == spec_id:
			return entry
	return {}


## The level a specialisation is chosen at, and the talent row levels.
static func spec_level(content: ContentDB) -> int:
	return int(content.rpg.get("talents", {}).get("spec_level", 0))


static func row_levels(content: ContentDB) -> Array[int]:
	var out: Array[int] = []
	for level: Variant in content.rpg.get("talents", {}).get("row_levels", []):
		out.append(int(level))
	return out


static func problems(content: ContentDB) -> PackedStringArray:
	var out := PackedStringArray()
	var all := classes(content)
	for class_id in ROSTER:
		if not all.has(class_id):
			out.append("rpg classes: %s missing" % class_id)
	for class_id: String in all:
		if class_id not in ROSTER:
			out.append("rpg classes: %s is not on the approved roster" % class_id)
			continue
		var def: Dictionary = all[class_id]
		var where := "rpg classes.%s" % class_id
		if str(def.get("resource", "")) not in RESOURCES:
			out.append(where + ": unknown resource")
		if str(def.get("armor", "")) not in ARMOR:
			out.append(where + ": unknown armor type")
		if (def.get("weapon_groups", []) as Array).is_empty():
			out.append(where + ": no weapon group")
		var seen := {}
		for entry: Dictionary in def.get("specs", []):
			var spec_where := "%s.%s" % [where, entry.get("id", "?")]
			if seen.has(entry.get("id")):
				out.append(spec_where + ": duplicate spec")
			seen[entry.get("id")] = true
			if str(entry.get("role", "")) not in ROLES:
				out.append(spec_where + ": unknown role")
			if str(entry.get("primary_stat", "")) not in PRIMARY_STATS:
				out.append(spec_where + ": unknown primary stat")
			if str(entry.get("display_name", "")) == "":
				out.append(spec_where + ": no display name")
			if str(entry.get("ref", {}).get("commit", "")) == "":
				out.append(spec_where + ": no source commit")
		if seen.size() != 3:
			out.append(where + ": expected 3 specialisations, found %d" % seen.size())
	if spec_level(content) <= 0 or row_levels(content).is_empty():
		out.append("rpg talents: spec level or row levels missing")
	return out
