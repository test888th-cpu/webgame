class_name RpgPack
extends RefCounted
## Read access to the playable slice's runtime pack (client/data/rpg/runtime_pack.json,
## generated by tools/content/build_runtime_pack.py from the pinned reference). The
## pack is ContentDB.rpg["runtime"]; nothing here reads files.


static func of(content: ContentDB) -> Dictionary:
	return content.rpg.get("runtime", {})


static func item(pack: Dictionary, item_id: String) -> Dictionary:
	return pack.get("items", {}).get(item_id, {})


static func monster(pack: Dictionary, monster_id: String) -> Dictionary:
	return pack.get("trial_monsters", {}).get(monster_id, {})


static func kit(pack: Dictionary, class_id: String) -> Dictionary:
	return pack.get("class_kits", {}).get(class_id, {})


static func swing(pack: Dictionary) -> Dictionary:
	return pack.get("swing", {})


static func constant(pack: Dictionary, key: String) -> Variant:
	return pack.get("constants", {}).get(key)


static func ability(pack: Dictionary, ability_id: String) -> Dictionary:
	return pack.get("abilities", {}).get(ability_id, {})


## Trial opponents a character of `level` may pick: those whose level band reaches
## within two levels of it, in level order.
static func trial_for_level(pack: Dictionary, level: int) -> Array[String]:
	var ids: Array[String] = []
	for id: String in pack.get("trial_monsters", {}):
		var m: Dictionary = pack["trial_monsters"][id]
		if int(m["level_min"]) <= level + 2:
			ids.append(id)
	ids.sort_custom(
		func(a: String, b: String) -> bool:
			var la := int(pack["trial_monsters"][a]["level_min"])
			var lb := int(pack["trial_monsters"][b]["level_min"])
			return la < lb or (la == lb and a < b)
	)
	return ids
