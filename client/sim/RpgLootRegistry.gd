class_name RpgLootRegistry
extends RefCounted
## The reference loot registry (Phase B2, docs/PHASE_B2_PLAN.md R7):
## data/registry/reference_loot_tables.json, reference_loot_entries.json and
## loot_selection.json, generated by tools/content/build_reference_registries.py
## from World of ClaudeCraft at the pinned commit. Pure, read-only accessors: the
## caller passes the documents (RpgRegistryLoader reads them). Nothing here rolls
## or drops loot; the game's own loot is unchanged.

const TABLE_KINDS: Array[String] = ["mob_loot", "heroic_append"]
## How each kind of table is rolled (the "rollers" section cites the source).
const ROLLERS: Array[String] = ["corpse", "corpse_heroic_append", "world_boss_personal"]
const ADOPTION: Array[String] = ["PENDING_REVIEW", "DEFERRED", "EXCLUDED", "NOT_APPLICABLE"]


static func tables(tables_doc: Dictionary) -> Dictionary:
	return tables_doc.get("tables", {})


static func table(tables_doc: Dictionary, table_id: String) -> Dictionary:
	return tables(tables_doc).get(table_id, {})


## A table's entries in roll order.
static func entries_of(tables_doc: Dictionary, entries_doc: Dictionary, table_id: String) -> Array:
	var out := []
	var all: Dictionary = entries_doc.get("entries", {})
	for entry_id: String in table(tables_doc, table_id).get("entries", []):
		out.append(all.get(entry_id, {}))
	return out


## Each roll group's chances summed in roll order, as the roller accumulates
## them. Never normalised: a total under 1 means the group can drop nothing.
static func group_totals(entries: Array) -> Dictionary:
	var out := {}
	for e: Dictionary in entries:
		var group: Variant = e.get("roll_group")
		if group is String and e.get("chance") is float:
			out[group] = float(out.get(group, 0.0)) + float(e["chance"])
	return out


## The inclusive copper range rollLoot draws for a base: ceil(base x 0.6) to
## ceil(base x 1.4) (src/sim/loot/loot_roll.ts).
static func copper_range(base: float) -> Vector2i:
	return Vector2i(ceili(base * 0.6), ceili(base * 1.4))


static func adoption(selection_doc: Dictionary, table_id: String) -> String:
	return str(selection_doc.get("tables", {}).get(table_id, {}).get("adoption", ""))


static func problems(
	tables_doc: Dictionary, entries_doc: Dictionary, items: Dictionary, monsters: Dictionary
) -> PackedStringArray:
	var out := PackedStringArray()
	var entries: Dictionary = entries_doc.get("entries", {})
	var seen := {}
	for table_id: String in tables(tables_doc):
		var t: Dictionary = tables(tables_doc)[table_id]
		var where := "loot table " + table_id
		if str(t.get("kind")) not in TABLE_KINDS:
			out.append(where + ": unknown kind")
		if str(t.get("roller")) not in ROLLERS:
			out.append(where + ": unknown roller")
		if not monsters.has(str(t.get("owner"))):
			out.append(where + ": owner is not a reference monster")
		var rows := entries_of(tables_doc, entries_doc, table_id)
		for i in rows.size():
			var e: Dictionary = rows[i]
			var entry_id := "%s#%d" % [table_id, i]
			if e.get("id") != entry_id or e.get("table") != table_id:
				out.append(where + ": entry %d is not %s" % [i, entry_id])
				continue
			seen[entry_id] = true
			out.append_array(_entry_problems(e, items))
		var stored: Dictionary = t.get("roll_group_totals", {})
		var totals := group_totals(rows)
		for group: String in totals:
			if not stored.has(group) or not is_equal_approx(float(stored[group]), totals[group]):
				out.append(where + ": group %s total differs from its entries" % group)
	for entry_id: String in entries:
		if not seen.has(entry_id):
			out.append("loot entry %s belongs to no table" % entry_id)
	return out


static func _entry_problems(e: Dictionary, items: Dictionary) -> PackedStringArray:
	var out := PackedStringArray()
	var where := "loot entry " + str(e.get("id"))
	var chance: Variant = e.get("chance")
	if not (chance is float) or chance < 0.0 or chance > 1.0:
		out.append(where + ": chance outside 0..1")
	var item: Variant = e.get("item")
	if item is Dictionary:
		var item_id := str(item.get("id"))
		var want := RpgRegistryLoader.namespaced(RpgRegistryLoader.REFERENCE, item_id)
		if item.get("namespaced_id") != want:
			out.append(where + ": item not in the reference namespace")
		if not items.has(item_id):
			out.append(where + ": item %s not in the reference item registry" % item_id)
	var copper: Variant = e.get("copper")
	if copper is float:
		var want_range := copper_range(copper)
		var got: Dictionary = e.get("copper_roll", {})
		if Vector2i(int(got.get("min", -1)), int(got.get("max", -1))) != want_range:
			out.append(where + ": copper range")
	if not e.get("unknown_values", []).is_empty():
		out.append(where + ": unknown values")
	return out
