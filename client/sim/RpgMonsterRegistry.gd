class_name RpgMonsterRegistry
extends RefCounted
## The reference monster registry (Phase B2, docs/PHASE_B2_PLAN.md R6):
## data/registry/reference_monsters.json, generated by
## tools/content/build_reference_registries.py from World of ClaudeCraft's MOBS
## table (and its Studio overlay) at the pinned commit. Pure: the caller passes
## the registry (RpgRegistryLoader reads it). Data only; no monster here is in the
## game.

## The source's own classifications, from its flags (VERIFIED). The reference has
## no mini-boss flag: "rare" is its rare-spawn flag, kept under its own name and
## never promoted to a mini-boss (owner decision, 2026-11-17).
const CLASSIFICATIONS: Array[String] = ["normal", "elite", "rare", "boss", "world_boss"]
const SELECTIONS: Array[String] = ["PENDING_REVIEW", "DEFERRED", "EXCLUDED", "NOT_AN_ENEMY"]
const CONTEXTS: Array[String] = [
	"world",
	"dungeon",
	"rift",
	"delve",
	"player_pet",
	"companion",
	"minigame_objective",
	"map_objective",
	"escort_objective",
]
const TABLES: Array[String] = ["MOBS", "STUDIO_CONTENT.mobs"]


static func monsters(registry: Dictionary) -> Dictionary:
	return registry.get("monsters", {})


## The classification the source flags give (never inferred from stats):
## worldBoss > boss > rare > elite > normal.
static func classification(monster: Dictionary) -> String:
	var flags: Dictionary = monster.get("flags", {})
	if flags.get("worldBoss", false):
		return "world_boss"
	if flags.get("boss", false):
		return "boss"
	if flags.get("rare", false):
		return "rare"
	if flags.get("elite", false):
		return "elite"
	return "normal"


## The selection label without its reason ("PENDING_REVIEW", "DEFERRED", ...).
static func selection(monster: Dictionary) -> String:
	return str(monster.get("selection", "")).split(":")[0]


static func problems(registry: Dictionary, items: Dictionary) -> PackedStringArray:
	var out := PackedStringArray()
	var mechanic_fields: Array = registry.get("mechanic_fields", [])
	for monster_id: String in monsters(registry):
		var m: Dictionary = monsters(registry)[monster_id]
		var where := "monster " + monster_id
		if m.get("id") != monster_id:
			out.append(where + ": id mismatch")
		if (
			m.get("namespaced_id")
			!= RpgRegistryLoader.namespaced(RpgRegistryLoader.REFERENCE, monster_id)
		):
			out.append(where + ": not in the reference namespace")
		if str(m.get("registry_table", "")) not in TABLES:
			out.append(where + ": unknown source table")
		var lo: Variant = m.get("level", {}).get("min")
		var hi: Variant = m.get("level", {}).get("max")
		if not (lo is float and hi is float) or lo > hi or lo < 1:
			out.append(where + ": bad level range")
		if selection(m) not in SELECTIONS:
			out.append(where + ": unknown selection")
		if str(m.get("context", "")) not in CONTEXTS:
			out.append(where + ": unknown context")
		if m.get("classification") != classification(m):
			out.append(where + ": classification does not follow the source flags")
		if m.has("proposed_role"):
			out.append(where + ": no role beyond the source classification")
		if str(m.get("ref", {}).get("file", "")) == "":
			out.append(where + ": no source file")
		if m.get("loot_table") != "mob:" + monster_id:
			out.append(where + ": loot table id")
		var fields: Dictionary = m.get("source_fields", {})
		for mechanic: String in m.get("mechanics", {}):
			if mechanic not in mechanic_fields:
				out.append(where + ": mechanic %s is not a MobTemplate field" % mechanic)
			elif fields.get(mechanic) != m["mechanics"][mechanic]:
				out.append(where + ": mechanic %s differs from its source field" % mechanic)
		if not m.get("unknown_values", []).is_empty():
			out.append(where + ": %d unknown values" % m["unknown_values"].size())
	if items.is_empty():
		out.append("the item registry is missing")
	return out
